% ==============================================================
%  EXAMPLE LAYOUT — longer form, research/academic flavoured.
%
%  This is ONE example, not a required format. Copy it and change
%  the sections and their order to suit your field. /tailor derives
%  the expected section list and reading order from this file's
%  section-heading macro calls, so the verify gate follows whatever you
%  write here. See templates/README.md.
%
%  Shape as shipped:
%    Header, Summary, Education, Experience, Skills,
%    Publications, Leadership, Awards
%  (Education before Experience, and Projects folded into
%   Experience, are academic conventions — change them freely.)
%
%  Selected automatically by a 2-page budget: /tailor --pages 2
%  (or by name, if paths.yaml maps one to this file)
%
%  ATS-safe rules locked here — see templates/README.md for why:
%   - margin 0.7in FLOOR (below this the scorer false-detects
%     multi-column: severity=fail, and extraction scrambles)
%   - single column, no tabular, no multicol
%   - no images, no icons, no graphical bullets
%   - mailto:/tel: hrefs so contact stays recoverable
%   - 11pt minimum, Times-clone serif bundled with Tectonic
% ==============================================================

% ==============================================================
%  Resume Tailor Agent — ATS-safe LaTeX template, TWO-PAGE variant
%
%  For research-scientist, national-lab, and senior industry roles
%  where a publication record and multi-project research history
%  are the qualification and cannot survive a one-page cut.
%
%  Agent: do NOT mechanically substitute placeholders. Read this
%  file as the PATTERN. For each run write a fresh resume.tex
%  following the same packages, section order, heading style,
%  bullet style, and link style.
%
%  Section order (skip any section with no profile content):
%    Header, Summary, Education, Experience, Skills,
%    Publications, Leadership, Awards
%
%  Differences from the one-page template:
%   - Education precedes Experience (academic convention)
%   - Experience roles may carry themed sub-groups (\rsubgroup)
%   - References is the LAST section, sized by --ref N (default 1)
%   - Publications section, newest first, status verbatim
%   - Leadership and Awards sections
%   - Page budget is 2, hard block at 3
%
%  ATS-safe rules locked here (identical to the one-pager):
%   - single column, no tabular, no multicol
%   - no images, no icons, no graphical bullets
%   - hyperref with mailto:/tel: so contact stays recoverable
%   - 11pt minimum, 0.7in margin floor
%   - Times-clone serif (newtxtext, free, bundled with Tectonic)
% ==============================================================

\documentclass[11pt,letterpaper]{article}

\usepackage{newtxtext,newtxmath}

% 0.7in is a HARD FLOOR, not a style choice. At 0.65in and below the bundled
% ATS scorer false-detects a two-column layout (severity=fail, -12) and the
% PDF text extraction scrambles: header sinks mid-document, lines split
% mid-word. Verified by bisection: 0.50-0.65 broken, 0.70+ clean (77 -> 92).
% Never tighten this margin to fit content. Cut content instead.
\usepackage[letterpaper,margin=0.7in]{geometry}

\usepackage[T1]{fontenc}
\usepackage{microtype}

\usepackage{enumitem}
\setlist[itemize]{leftmargin=*,topsep=2pt,itemsep=1pt,parsep=0pt}

\usepackage[hidelinks]{hyperref}

% Section heading — bold uppercase + rule. Hand-rolled: titlesec
% breaks against newtxtext + \MakeUppercase.
\newcommand{\rsection}[1]{%
  \par\vspace{5pt}%
  \noindent{\large\bfseries\spaceskip=0.33em plus 0.14em minus 0.02em
    \MakeUppercase{#1}}%
  \par\vspace{-6pt}%
  \noindent\rule{\linewidth}{0.5pt}%
  \par\vspace{2pt}%
}

% Themed sub-group inside one role (e.g. "AI/ML", "Software Development").
% Indented one step, with its bullets one step further, so the hierarchy is
% visible: role title at the margin, theme under it, evidence under that.
% A flush-left bold theme reads as a peer of the job title -- that is the
% layout this replaced.
% The open-circle marker is measured, not assumed: against the bundled scorer
% it costs nothing (ATS 100, JD 63, identical to the text-only version) and
% the extractor reads the line as a proper list item rather than as a stray
% bold line, which preserves reading order. Keep it out of the bullet TEXT
% though -- glyphs belong to the marker, never to the content.
% \par forces vertical mode first, so the heading cannot be swallowed into a
% preceding line, and avoids the underfull-hbox warning a trailing \\ causes.
\newlength{\rsubindent}\setlength{\rsubindent}{1.1em}
\newcommand{\rsubgroup}[1]{%
  \par\vspace{3pt}%
  \noindent\hspace*{\rsubindent}$\circ$~\textbf{#1}%
  \par\vspace{1pt}%
}

% Bullets belonging to an \rsubgroup -- one indent step past its heading.
% A role with a single focus takes a plain itemize at the margin instead.
\newenvironment{rsubitems}
  {\begin{itemize}[leftmargin=2.6em,topsep=0pt,itemsep=1pt,parsep=0pt]}
  {\end{itemize}}

\setlength{\parindent}{0pt}
\pagestyle{empty}

% ---- word-boundary safety (do not delete) --------------------------------
% When TeX squeezes a justified line, the interword space can shrink below
% what a PDF text extractor needs to see a word boundary, and a whole phrase
% comes out of the parser as one unreadable token. Zeroing the shrink and
% raising the tolerance makes TeX accept a slightly loose line instead.
% Verified against the bundled scorer: without this, summary and bullet text
% extracts as "graphneuralnetworks,machine-learnedinteratomicpotentials".
\tolerance=3000
\emergencystretch=3em
% Hyphenation is suppressed outright. A word broken across a line survives
% into the extracted text WITH the hyphen -- "configu-ration sampling",
% "agen-tic", "develop-ment" -- so the keyword never matches the JD even
% though the printed page is correct. Both penalties are needed:
% \hyphenpenalty stops TeX's automatic hyphenation, \exhyphenpenalty stops it
% breaking at a hyphen the word already contains ("state-of-" / "the-art").
\hyphenpenalty=10000
\exhyphenpenalty=10000
\AtBeginDocument{\fontdimen4\font=0pt}

% ---- summary block -------------------------------------------------------
% The summary is JUSTIFIED, like every other paragraph in the document.
% Never wrap it in \raggedright: it reads as unfinished beside justified
% bullets, and the settings above already prevent the extraction damage that
% ragged setting was sometimes used to dodge.
%
% \rsummary measures its own rendered height and writes
%     SUMMARY-LINES: N
% into the .log, so the four-line budget is checkable exactly the way the
% page budget is. See the structural-verify step in the playbook.
\newsavebox{\rsummarybox}
\newlength{\rsummaryht}
\newcommand{\rsummary}[1]{%
  \begin{lrbox}{\rsummarybox}%
    \begin{minipage}{\linewidth}#1\end{minipage}%
  \end{lrbox}%
  \setlength{\rsummaryht}{\ht\rsummarybox}%
  \addtolength{\rsummaryht}{\dp\rsummarybox}%
  \typeout{SUMMARY-LINES: \the\numexpr
    (\number\rsummaryht*2 + \number\dimexpr\baselineskip\relax)
    /(2*\number\dimexpr\baselineskip\relax)\relax}%
  \noindent\usebox{\rsummarybox}\par%
}

\begin{document}

% ====================== Header ======================
\begin{center}
  {\Large\bfseries Full Name}\\[2pt]
  City, ST, ZIP $\cdot$
  \href{mailto:name@lab.gov}{name@lab.gov} $\cdot$
  \href{tel:+15555555555}{+1 555 555 5555}\\[1pt]
  \href{https://linkedin.com/in/username}{linkedin.com/in/username} $\cdot$
  \href{https://example.pages.dev/}{Personal Website} $\cdot$
  \href{https://scholar.google.com/citations?user=XXXX}{Google Scholar}
\end{center}

% ====================== Summary ======================
% Justified, and at most FOUR rendered lines -- \rsummary writes
% "SUMMARY-LINES: N" to the .log so the budget is verifiable.
\rsection{Summary}
\rsummary{Two-to-three-line factual statement. Lead with the disciplinary identity, then the
methods that back it, then the collaboration or delivery record. Weighted toward JD
language the profile genuinely supports. No fabrication, no AI filler.}

% ====================== Education ======================
\rsection{Education}

\textbf{Ph.D. in Field} \hfill Mon YYYY -- Mon YYYY\\
\textit{University Name} \hfill City, ST\\
CGPA: X.XX/4.00

\vspace{3pt}
\textbf{B.Sc. in Field} \hfill Mon YYYY -- Mon YYYY\\
\textit{University Name} \hfill City, Country\\
CGPA: X.XX/4.00

% ====================== Experience ======================
% Themed sub-groups are optional. Use them only when a role spans
% genuinely distinct workstreams; a role with one focus takes a flat
% bullet list like the one-page template.
\rsection{Research Experience}

\textbf{Position Title} \hfill Mon YYYY -- Current\\
\textit{Division, Organization} \hfill City, ST

\rsubgroup{First Theme}
\begin{rsubitems}
  \item Action verb opening. One factual outcome, quantified when a real number exists.
  \item Second bullet only when it adds a distinct signal.
\end{rsubitems}

\rsubgroup{Second Theme}
\begin{rsubitems}
  \item Reorder or drop whole sub-groups per JD relevance. Never invent one.
\end{rsubitems}

\vspace{4pt}
\textbf{Earlier Position} \hfill Mon YYYY -- Mon YYYY\\
\textit{Department, Organization} \hfill City, ST
\begin{itemize}
  \item Flat list when the role had a single focus. Up to 5 bullets per role.
\end{itemize}

% ====================== Skills ======================
% Categorized lines. The scorer's Tier 1 gazetteer reads these directly.
\rsection{Skills}
\textbf{Programming Languages:} Python, Shell scripting, Linux, \LaTeX\\
\textbf{Computational Techniques:} Molecular dynamics, Density functional theory, HPC\\
\textbf{Machine Learning:} MLIPs (training, finetuning, distillation), Graph neural networks

% ====================== Publications ======================
% Newest first. Bold the profile owner's surname so a human skim finds it.
% Status markers are copied VERBATIM from the profile. Never upgrade
% "Submitted" or "under review" to published — that is fabrication.
% Selecting a relevant subset is fine; say "Highlighted (Total N)".
\rsection{Highlighted Journal Publications (Total N)}
\begin{itemize}
  \item \textbf{Lastname, A.B.}, Coauthor, A., and Coauthor, B., YYYY. Full title of the
        paper as published. \textit{Journal Name}, Vol(Issue), pp.XX-XX.
  \item \textbf{Lastname, A.B.}, and Coauthor, C., YYYY. Another title.
        (Accepted, \textit{Journal Name}.)
\end{itemize}

% ====================== Leadership (skip if empty) ======================
\rsection{Leadership \& Teamwork Experience}

\textbf{Role Title} \hfill Mon YYYY -- Mon YYYY\\
\textit{Program, Organization} \hfill City, ST
\begin{itemize}
  \item One bullet. What was led, for whom, at what scale.
\end{itemize}

% ====================== Awards (skip if empty) ======================
\rsection{Selected Awards \& Honors}
\begin{itemize}
  \item \textbf{Award Name} (\$Amount), Awarding Body \hfill Season YYYY
\end{itemize}

% ====================== References (LAST section) ======================
% Populated from profile.references[] and controlled by --ref N:
%   --ref 0   drop this section entirely
%   --ref 1   the single entry with "default": true  (this is the default)
%   --ref N>1 the agent asks which N of the profile's references to use
% Keep this LAST. If the profile has no references[], drop the section
% rather than shipping an empty heading.
\rsection{References}
\begin{itemize}
  \item \textbf{Dr. Referee Name} (\href{mailto:email@org.gov}{email@org.gov})\\
        Title, Division, Organization
\end{itemize}

\end{document}
